# Copy to .env for local development. Never commit the real .env.

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# HTTP server (the platform usually injects PORT itself)
HOST=0.0.0.0
PORT=8080

# Postgres. Leave unset to run without a database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Agent loop pacing
AGENT_INTERVAL_SECONDS=30
AGENT_ERROR_BACKOFF_SECONDS=5
AGENT_MAX_BACKOFF_SECONDS=300

# Seconds to let in-flight work finish after SIGTERM
SHUTDOWN_GRACE_SECONDS=20
