# Copy to .env for local development. Never commit the real .env.

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# HTTP server (the platform usually injects PORT itself)
HOST=0.0.0.0
PORT=8080

# Postgres. Leave unset to run without a database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Connection pool. Against serverless Postgres that bills compute time (Neon),
# set DB_POOL_MIN_SIZE=0 — an idle connection keeps its compute awake.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_MAX_IDLE_SECONDS=120

# Agent loop pacing
AGENT_INTERVAL_SECONDS=30
AGENT_ERROR_BACKOFF_SECONDS=5
AGENT_MAX_BACKOFF_SECONDS=300

# Seconds to let in-flight work finish after SIGTERM
SHUTDOWN_GRACE_SECONDS=20

# --- Alpaca -----------------------------------------------------------------
# Paper-agents credentials. Names only here; real values go in .env locally
# and in the Render dashboard in production. Never commit either.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper-only, and not really a knob. The MCP transport pins the server's own
# ALPACA_PAPER_TRADE to "true" regardless of what you put here, and startup
# fails outright if this is set to a value that would select live agents.
# The server accepts only true/1/yes (case-insensitive, NOT whitespace-trimmed);
# anything else — including "paper" or "true " — selects the live endpoint.
ALPACA_PAPER_TRADE=true
# Which MCP toolsets to expose. Fewer tools means a smaller, faster server —
# but an unrecognised name is silently ignored, so a typo removes tools with
# no error at all. `trading` carries positions, orders, place_option_order and
# close_position; without it the service starts healthy and cannot trade.
ALPACA_TOOLSETS=account,trading,assets,options-data,stock-data,news
MCP_CALL_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2

# --- Trading universe and safety --------------------------------------------
UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,TSLA,META,GOOGL
# While true, no order-placing tool can reach Alpaca. The guard lives in the
# MCP transport, so this holds even if a call site forgets to check it.
DRY_RUN=true
# Env-level halt. The kill_switch database row is checked in addition to this.
KILL_SWITCH=false
# Testing only. Out of hours every agent stops at its first market-open check,
# so the autonomous chain never runs end to end on a weekend or overnight.
# This replays the most recent *real* session from the market_calendar cache
# (it cannot invent one). Decisions are then built on last session's data, so
# startup refuses to run this with DRY_RUN=false.
REPLAY_LAST_SESSION=false

# --- Per-agent cadence ------------------------------------------------------
MARKET_PULSE_INTERVAL_SECONDS=60
EXECUTION_AGENT_INTERVAL_SECONDS=30

# --- Strategy construction ---------------------------------------------------
RISK_FREE_RATE=0.045
LIMIT_PRICE_SPREAD_NUDGE_PCT=0.25
STANDARD_MONTHLY_EXPIRY_PREFERENCE=true
# Structure quality floors. Measured credit/width by short delta, on a 38-day
# chain (width barely moves this ratio — short delta is the lever):
#   0.15 -> ~10%   0.20 -> ~14%   0.25 -> ~18%   0.30 -> ~21%   0.35 -> ~27%
# 12%, not 15%: at 15% the calibrated 0.20-delta setup is unreachable. For a
# fatter credit raise the short delta, not the wing width.
# Wing distance as a multiple of the expected move (spot x IV x sqrt(dte/365)),
# not a flat dollar amount: $5 wings are a fifth of the expected move on SPY at
# 769 and several times it on a $30 name. Measured on real SPY and NVDA chains
# at 21-38 DTE, 0.45 puts the credit verticals at 15-19% of width and the iron
# condor at 33%. An at-the-money short collects far more premium, so an iron
# butterfly needs much wider wings for a profit zone to exist at all — at 0.45
# it collects ~96% of its width and is refused. Set to 0 to disable scaling and
# fall back to SPREAD_WIDTH_DEFAULT.
SPREAD_WIDTH_EXPECTED_MOVE_MULT=0.45
SPREAD_WIDTH_EXPECTED_MOVE_MULT_ATM=1.25
MIN_CREDIT_WIDTH_PCT=0.12
# The ceiling catches the opposite failure: a structure collecting most of its
# width has almost no profit zone, and its tiny max loss is what makes sizing
# scale the trade up. A 5-wide ATM iron butterfly on SPY collected 95.7%.
MAX_CREDIT_WIDTH_PCT=0.70
MAX_DEBIT_WIDTH_PCT=0.45
MIN_REWARD_RISK=1.0

# --- Risk limits -------------------------------------------------------------
MAX_PREMIUM_PCT_PER_TRADE=0.02
MAX_TOTAL_PREMIUM_PCT=0.15
MAX_CONCURRENT_POSITIONS=5
MAX_POSITIONS_PER_UNDERLYING=1
RISK_DTE_MIN=7
RISK_DTE_MAX=45
MIN_OPEN_INTEREST=100
MAX_SPREAD_PCT=0.10
# A leg is refused only when it is wide in both senses. A cheap wing quoted
# 0.10/0.15 is 40% wide but five cents to cross, and those wings are what make
# an iron condor defined-risk.
MAX_SPREAD_ABS=0.05
DAILY_LOSS_HALT_PCT=0.03
DRAWDOWN_HALT_PCT=0.08
MINUTES_BEFORE_CLOSE_BLACKOUT=15

# --- Dashboard ----------------------------------------------------------------
# Shared bearer token the separate Next.js dashboard sends on every guarded
# /api/* call. Unset means those routes are unauthenticated (fine locally,
# never in a deployment reachable from the public internet). Never commit
# the real value.
ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the guarded /api/* routes.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Featherless ----------------------------------------------------------------
# Sponsor-provided LLM, reached over its OpenAI-compatible chat/completions
# endpoint. Two consumers: the read-only dashboard chat and StrategistAgent.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# No default on purpose: never hardcode a model id in source.
FEATHERLESS_CHAT_MODEL=
# StrategistAgent's model — one call per iteration. Leaving this empty is not
# an error but it is a silent no-op: the agent reports "llm_not_configured"
# every tick and no proposal is ever produced.
FEATHERLESS_MODEL_DEEP=
CHAT_MAX_TOOL_CALLS=4
CHAT_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
# Soft daily ceiling. Only halts StrategistAgent — exits must always work.
LLM_DAILY_TOKEN_BUDGET=100000

# --- StrategistAgent ------------------------------------------------------------
STRATEGIST_INTERVAL_SECONDS=300
# Conviction below this floor forces a hold even when the matrix would fire.
CONVICTION_FLOOR=0.55
REFLECTION_INTERVAL_SECONDS=3600
POSITION_MANAGER_INTERVAL_SECONDS=60

# --- Telegram notifications -----------------------------------------------------
# Outbound only: the agents push decisions, orders, a periodic portfolio
# snapshot and error alerts. There is no bot listener and no command handling.
#
# Leaving TELEGRAM_BOT_TOKEN (or the chat id) empty disables notifications
# entirely — the process boots normally and the reporter agent is not even
# registered. Get a token from @BotFather; get your chat id by messaging the
# bot and reading getUpdates, or from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_DECISIONS=true
TELEGRAM_NOTIFY_ORDERS=true
TELEGRAM_NOTIFY_ERRORS=true
# Cadence of the portfolio snapshot, gated on market hours — so this is a
# within-session cadence, not a wall-clock one. One final snapshot is also
# sent on the first tick after the session closes.
TELEGRAM_SUMMARY_INTERVAL_SECONDS=1800
# Suppress an identical message inside this window. An error storm repeats one
# message thousands of times and Telegram 429s well before that.
TELEGRAM_DEDUPE_SECONDS=300
# What keeps a slow Telegram away from the trading loop: past this queue depth
# the oldest message is dropped rather than awaited.
TELEGRAM_QUEUE_MAX=100
TELEGRAM_TIMEOUT_SECONDS=10
