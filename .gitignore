__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
