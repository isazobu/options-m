# Editors / OS
.idea/
.vscode/
.DS_Store

# Local tooling state
.observer.lock
observer.log

# Stray artifact, not produced by this project's build
tests.zip

# Backtest raw data — 13MB of Alpaca CLI output, re-fetchable from the
# parameters and SHA-256 digests recorded in each run's data_fingerprint.json
backtests/runs/*/raw/
# ...and the symlink form: a later run points `raw` at an earlier run's cache,
# and the pattern above (trailing slash) matches only real directories. Tracking
# the link would leave it dangling in a fresh clone.
backtests/runs/*/raw
